import tkinter as tk
from tkinter import ttk

class DirectoryApp:
    def __init__(self, root):
        self.root = root
        self.root.title("DiceScribe -  Directory")

        self.frame = ttk.Frame(root)
        self.frame.pack(expand=True, fill='both', padx=10, pady=10)

        self.title_label = ttk.Label(self.frame, text="Directory", font=("Arial", 16, "bold"))
        self.title_label.pack(pady=(0, 10))

        self.scenes = [
            ("Session 12: Betrayal at the Keep", "The party is betrayed by a trusted ally inside the fortress."),
            ("Session 13: The Oracle's Warning", "The oracle delivers a cryptic warning about an approaching threat."),
            ("Session 14: Final Battle Under the Moon", "The final showdown takes place beneath a blood-red moon."),
            ("Session 12 Notes", "this is where I keep all my important notes for Session 12."),
             ("Session 13 Notes", "this is where I keep all my important notes for Session 13."),
              ("Session 14 Notes", "this is where I keep all my important notes for Session 14."),
        ]

        self.create_scene_buttons()

    def create_scene_buttons(self):
        for title, summary in self.scenes:
            btn = ttk.Button(self.frame, text=title, command=lambda t=title, s=summary: self.show_scene(t, s))
            btn.pack(fill='x', pady=5)

    def show_scene(self, title, summary):
        top = tk.Toplevel(self.root)
        top.title(title)
        ttk.Label(top, text=title, font=("Arial", 14, "bold"), padding=10).pack()
        ttk.Label(top, text=summary, wraplength=400, padding=10).pack()

if __name__ == "__main__":
    root = tk.Tk()
    app = DirectoryApp(root)
    root.mainloop()
